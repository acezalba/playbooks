source_if_exists () {
    if test -r "$1"; then
        source "$1"
    fi
}

export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="dst"
plugins=(git)
source $ZSH/oh-my-zsh.sh

# ZSH-Custom
# If you see this post, this means that
# Your zsh installation is ansible-managed.
# Each role, when necessary, is encouraged to have their
# specific shell files configs, separated into
# PATHS, ALIASES, AND CONFIG

export CONFIG_DIR="$HOME/.config/shell-files/zsh"

source_if_exists $CONFIG_DIR/paths.zsh
source_if_exists $CONFIG_DIR/aliases.zsh
source_if_exists $CONFIG_DIR/config.zsh